# Source development only. Docker releases use scripts/release.py and generated file secrets; see README.
# Copy to .env and fill locally. Never put provider keys in VITE_*.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ai_radar
DB_USER=radar
DB_PASSWORD=
POSTGRES_DB=ai_radar
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
ADMIN_TOKEN=
BUSINESS_TIMEZONE=Asia/Shanghai
# Offline event extraction only. Keep provider credentials server-side.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=1600

# Use cloudflare only when system DNS synthesizes private/proxy addresses.
FETCH_DNS_MODE=system

# Minimum pause between worker jobs; source rate limits persist independently.
FETCH_INTERVAL_SECONDS=10

# Public assistant: generate a stable private secret (32+ characters) on the server.
# Missing secret disables paid public answers. Keep it in backups; never expose via VITE_*.
# PUBLIC_ASSISTANT_SECRET=
ASSISTANT_INPUT_PER_DAY=200000
ASSISTANT_OUTPUT_PER_DAY=32000
