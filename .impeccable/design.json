      "html": "<button class=\"ds-primary\">开始分析</button>",
      "css": ".ds-primary{font-family:Inter, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:16px;line-height:1.6;min-height:44px;padding:8px 12px;border:1px solid var(--line, #d4dee9);border-radius:8px;background:var(--paper, #fff);color:var(--ink, #10223b);cursor:pointer}.ds-primary:hover{background:var(--blue-soft, #e8f0fa);border-color:#9cb8d4}.ds-primary:disabled{opacity:.52;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--focus, #175b95);outline-offset:2px}.ds-primary,.ds-primary:hover{background:var(--blue, #123d73);color:var(--paper, #fff);border-color:var(--blue, #123d73)}",
