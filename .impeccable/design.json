      "css": ".ds-label{font-family:Inter, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:16px;line-height:1.6;display:grid;gap:4px;font-size:14px;color:var(--ink, #10223b)}.ds-input{font-family:Inter, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:16px;line-height:1.6;width:100%;min-height:44px;border:1px solid var(--line, #d4dee9);border-radius:8px;padding:8px 10px;background:var(--paper, #fff);color:var(--ink, #10223b);caret-color:var(--blue, #123d73)}.ds-input:focus-visible{outline:3px solid var(--focus, #175b95);outline-offset:2px}",
