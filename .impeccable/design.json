      "css": ".ds-nav{font-family:Inter, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;font-size:16px;line-height:1.6;display:grid;gap:4px}.ds-nav a{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;color:var(--muted, #5b6d82);text-decoration:none;white-space:nowrap}.ds-nav .ds-current{color:var(--blue, #123d73);font-weight:700}.ds-nav svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}.ds-nav a:focus-visible{outline:3px solid var(--focus, #175b95);outline-offset:2px}@media(max-width:900px){.ds-nav{display:flex;overflow:auto}}",
